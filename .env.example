# Frontend Supabase config.
# For local Telegram tunnel runs, npm run dev:telegram updates VITE_SUPABASE_URL automatically.
VITE_SUPABASE_URL="http://127.0.0.1:55421"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_DEV_TOOLS_ENABLED="false"

# OpenRouter key for Supabase Edge Function generate-reading-text.
# Keep it only on server side (.env.local), never expose in frontend code.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Telegram bot token for server-side initData validation in Edge Functions.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Local-only server switch for Supabase Edge Function dev-tools.
# Keep "false" unless you intentionally run local dev tools.
DEV_TOOLS_ENABLED="false"

# Optional: primary, fallback and tertiary free models for OpenRouter.
# You can change models without touching application code.
OPENROUTER_MODEL_PRIMARY="openai/gpt-oss-20b:free"
OPENROUTER_MODEL_FALLBACK="google/gemma-3-12b-it:free"
OPENROUTER_MODEL_TERTIARY="qwen/qwen3.6-plus:free"
