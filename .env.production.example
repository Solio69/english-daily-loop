# Production environment inventory only.
# Do not copy this file into a local runtime env and never commit real values.
#
# Actual frontend values live in Vercel Environment Variables.
# Actual server values live in Supabase Cloud Edge Function Secrets.

# Vercel: public frontend configuration embedded into the Vite bundle.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PRODUCTION_PUBLISHABLE_OR_ANON_KEY"
VITE_FEEDBACK_TELEGRAM_USERNAME=""

# Supabase Cloud: server-only Edge Function secrets.
OPENROUTER_API_KEY="YOUR_PRODUCTION_OPENROUTER_API_KEY"
TELEGRAM_BOT_TOKEN="YOUR_PRODUCTION_TELEGRAM_BOT_TOKEN"
TELEGRAM_BOT_WEBHOOK_SECRET="YOUR_PRODUCTION_TELEGRAM_WEBHOOK_SECRET"
DEV_TOOLS_ENABLED="true"
SUBSCRIPTION_FLOW_ENABLED="false"

# Supabase Cloud: optional OpenRouter routing configuration.
OPENROUTER_MODEL_CHAIN="nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-super-vl:free"
OPENROUTER_MODEL_PRIMARY=""
OPENROUTER_MODEL_FALLBACK=""
OPENROUTER_MODEL_TERTIARY=""

# Supabase automatically provides SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY to deployed Edge Functions. Do not duplicate them.
