# Copy this file to .env.telegram.local for npm run dev:telegram.
# The command never reads or writes .env.local or production platform secrets.
TELEGRAM_DEV_MODE="true"
DEV_TELEGRAM_BOT_USERNAME="@YOUR_DEV_BOT_USERNAME"

# Development bot token used only by locally served Edge Functions.
TELEGRAM_BOT_TOKEN="YOUR_DEV_TELEGRAM_BOT_TOKEN"

# Random 32-256 character secret used to authenticate Telegram webhook requests.
TELEGRAM_BOT_WEBHOOK_SECRET="YOUR_RANDOM_DEV_WEBHOOK_SECRET"

# Automatically replaced with local Supabase/tunnel values on startup.
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="AUTO_FILLED_BY_DEV_TELEGRAM"

# Local server-side AI access.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL_CHAIN="nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-super-vl:free"
OPENROUTER_MODEL_PRIMARY=""
OPENROUTER_MODEL_FALLBACK=""
OPENROUTER_MODEL_TERTIARY=""

VITE_FEEDBACK_TELEGRAM_USERNAME=""
DEV_TOOLS_ENABLED="true"
SUBSCRIPTION_FLOW_ENABLED="false"
