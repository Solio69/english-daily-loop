{
  "name": "english-daily-loop",
  "private": true,
  "version": "1.1.14",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "dev:telegram": "node scripts/dev-stack.mjs",
    "telegram:dev:webhook:delete": "node scripts/telegram/delete-dev-webhook.mjs",
    "dev:stop": "npx supabase stop",
    "build": "vite build",
    "build:telegram": "vite build --mode telegram-dev",
    "watch:telegram": "vite build --mode telegram-dev --watch",
    "preview": "vite preview",
    "preview:telegram": "vite preview --mode telegram-dev --outDir dist-telegram --host=0.0.0.0 --port=3000 --strictPort",
    "clean": "node -e \"for (const dir of ['dist', 'dist-telegram']) require('node:fs').rmSync(dir, { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/quality/check-code.mjs lint",
    "format:check": "node scripts/quality/check-code.mjs format",
    "lint:styles": "node scripts/quality/check-code.mjs styles",
    "test:legacy": "tsx --test tests/*.test.ts",
    "test:unit": "vitest run",
    "test": "tsx --test tests/*.test.ts && vitest run",
    "test:all": "npm run test && npm run test:e2e && npm run test:edge",
    "test:e2e": "playwright test",
    "test:edge": "node scripts/quality/run-deno.mjs",
    "release:check": "tsx scripts/release-check.ts",
    "backup:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/backup/initialize-production-backup.ps1",
    "backup:schedule": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/backup/register-production-backup-task.ps1",
    "backup:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/backup/run-production-backup.ps1",
    "backup:status": "tsx scripts/backup/status.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@supabase/supabase-js": "^2.101.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^2.85.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.4"
  }
}
